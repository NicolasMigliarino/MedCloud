# Copiar a .env y completar. Nunca commitear el .env real.

# Servidor
PORT=3000

# Base de datos SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MedCloud
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false

# Firma de las sesiones (obligatorio, mínimo 32 caracteres; sin esto el servidor no arranca).
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=

# Correo saliente (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# URL pública del frontend (links de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# URL pública del backend (links de confirmación de turnos en los mails)
BACKEND_URL=http://localhost:3000
