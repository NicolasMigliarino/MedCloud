# Copiar a .env y completar. Nunca commitear el .env real.

# Servidor
PORT=3000

# Base de datos SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MedCloud
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false

# Firma de las sesiones (obligatorio, mínimo 32 caracteres; sin esto el servidor no arranca).
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=

# Zona horaria del proceso: las horas que carga el formulario de turnos se interpretan en esta zona.
# En Docker es obligatoria (los contenedores vienen en UTC y los turnos quedarían corridos 3 horas).
TZ=America/Argentina/Buenos_Aires

# Mails: servicio de mensajería de MuchoCodigo (muchocodigo-mensajeria, envía por Resend).
# En el servidor, por la red Docker "muchocodigo": http://mensajeria-api:3100
# La clave es la del cliente (la clínica), generada en la mensajería con clave-crear (empieza con mc_).
# Sin estas dos variables MedCloud funciona igual, pero no manda mails.
MENSAJERIA_URL=http://localhost:3100
MENSAJERIA_CLAVE=

# Casilla que recibe los pedidos de la pantalla Soporte
SOPORTE_EMAIL=

# URL pública del frontend (links de recuperación de contraseña; obligatoria para recuperar la clave)
FRONTEND_URL=http://localhost:5173

# URL pública del backend (links firmados para confirmar o cancelar turnos desde el mail)
BACKEND_URL=http://localhost:3000
